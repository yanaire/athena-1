{
  "name": "athena-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "windows:prepare": "node scripts/prepare-windows-storage.mjs",
    "prestart": "node scripts/prepare-windows-storage.mjs",
    "start": "node runtime/server.ts",
    "check": "tsc --noEmit",
    "pretest": "node scripts/prepare-windows-storage.mjs",
    "test": "node --test tests/*.test.*",
    "preanalysis:prepare": "node scripts/prepare-windows-storage.mjs",
    "analysis:prepare": "node scripts/prepare-analysis.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:build:mac-intel": "node scripts/build-desktop.mjs --target x86_64-apple-darwin",
    "desktop:build:windows": "node scripts/build-desktop.mjs --target x86_64-pc-windows-msvc",
    "desktop:build:local-chatgpt": "node scripts/build-desktop.mjs --local-chatgpt"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@rgrove/parse-xml": "5.2.0",
    "marked": "18.0.11",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
